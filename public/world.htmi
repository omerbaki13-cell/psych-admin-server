<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Konser Alanı</title>
<style>
  html, body { margin:0; padding:0; overflow:hidden; background:#000; font-family:sans-serif; }
  #loginBox { max-width:320px; margin:100px auto; text-align:center; color:#eee; background:#1e1e2f; padding:24px; border-radius:12px; }
  #loginBox h1 { color:#ff5fa2; font-size:22px; }
  #loginBox input { width:100%; box-sizing:border-box; padding:10px; margin-top:10px; border-radius:6px; border:none; font-size:14px; }
  #loginBox button { width:100%; margin-top:14px; padding:10px; border:none; border-radius:6px; background:#ff5fa2; color:#fff; font-weight:bold; cursor:pointer; font-size:15px; }
  #loginBox button:hover { background:#ff3d91; }
  #loginStatus { margin-top:10px; font-size:13px; color:#f88; min-height:16px; }
  #hint { position:fixed; bottom:16px; left:16px; color:#fff; font-size:13px; background:rgba(0,0,0,0.5); padding:8px 12px; border-radius:8px; display:none; }
  #crosshair { position:fixed; top:50%; left:50%; width:6px; height:6px; background:#fff; border-radius:50%; transform:translate(-50%,-50%); display:none; }
  canvas { display:block; }
</style>
</head>
<body>

<div id="loginBox">
  <h1>🎤 Konser Alanına Giriş</h1>
  <input type="text" id="userInput" placeholder="Kullanıcı adı">
  <input type="password" id="passInput" placeholder="Şifre">
  <button onclick="doLogin()">Giriş Yap</button>
  <div id="loginStatus"></div>
</div>

<div id="hint">Sol: joystick ile yürü | Sağ: parmakla ekrana sürükleyip bak</div>
<div id="crosshair"></div>

<div id="joystick" style="position:fixed; bottom:30px; left:30px; width:110px; height:110px; border-radius:50%; background:rgba(255,255,255,0.15); display:none; touch-action:none;">
  <div id="joystickKnob" style="position:absolute; top:35px; left:35px; width:40px; height:40px; border-radius:50%; background:rgba(255,255,255,0.5);"></div>
</div>
<div id="lookZone" style="position:fixed; top:0; right:0; width:50%; height:100%; display:none; touch-action:none;"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const API = window.location.origin;

async function doLogin() {
  const username = document.getElementById("userInput").value.trim();
  const password = document.getElementById("passInput").value;
  const statusEl = document.getElementById("loginStatus");
  if (!username || !password) {
    statusEl.innerText = "Kullanıcı adı ve şifre gir!";
    return;
  }
  statusEl.style.color = "#8fd";
  statusEl.innerText = "Bağlanılıyor...";
  try {
    const res = await fetch(API + "/login", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ username, password })
    });
    if (res.ok) {
      document.getElementById("loginBox").style.display = "none";
      document.getElementById("hint").style.display = "block";
      if (!isTouchDevice()) { document.getElementById("crosshair").style.display = "block"; }
function isTouchDevice(){ return ('ontouchstart' in window) || navigator.maxTouchPoints > 0; }
      startWorld(username);
    } else {
      statusEl.style.color = "#f88";
      statusEl.innerText = "Kullanıcı adı veya şifre yanlış!";
    }
  } catch (e) {
    statusEl.style.color = "#f88";
    statusEl.innerText = "Sunucuya bağlanılamadı, tekrar dene.";
  }
}

function startWorld(username) {
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x0a0a15);
  scene.fog = new THREE.Fog(0x0a0a15, 10, 80);

  const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.set(0, 1.7, 25);

  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.shadowMap.enabled = true;
  document.body.appendChild(renderer.domElement);

  // Zemin (konser alanı)
  const floor = new THREE.Mesh(
    new THREE.PlaneGeometry(100, 100),
    new THREE.MeshStandardMaterial({ color: 0x1a1a2a })
  );
  floor.rotation.x = -Math.PI / 2;
  floor.receiveShadow = true;
  scene.add(floor);

  // Sahne (stage)
  const stage = new THREE.Mesh(
    new THREE.BoxGeometry(20, 1.5, 10),
    new THREE.MeshStandardMaterial({ color: 0x333344 })
  );
  stage.position.set(0, 0.75, -20);
  stage.castShadow = true;
  scene.add(stage);

  // Sahne arkası ekran
  const screenMesh = new THREE.Mesh(
    new THREE.PlaneGeometry(18, 8),
    new THREE.MeshStandardMaterial({ color: 0xff5fa2, emissive: 0xff2f82, emissiveIntensity: 0.6 })
  );
  screenMesh.position.set(0, 6, -24.9);
  scene.add(screenMesh);

  // Sahne ışıkları (renkli spot ışıklar)
  const lightColors = [0xff2f82, 0x2fd0ff, 0xfff02f, 0x7dff2f];
  for (let i = 0; i < 4; i++) {
    const light = new THREE.PointLight(lightColors[i], 2, 30);
    light.position.set(-9 + i * 6, 8, -18);
    light.castShadow = true;
    scene.add(light);

    const bulb = new THREE.Mesh(
      new THREE.SphereGeometry(0.3, 8, 8),
      new THREE.MeshBasicMaterial({ color: lightColors[i] })
    );
    bulb.position.copy(light.position);
    scene.add(bulb);
  }

  const ambient = new THREE.AmbientLight(0x404060, 1.2);
  scene.add(ambient);

  // Kalabalık (basit kutular/silindirler, ızgara şeklinde)
  const crowdMat = new THREE.MeshStandardMaterial({ color: 0x555577 });
  for (let x = -18; x <= 18; x += 3) {
    for (let z = -6; z <= 18; z += 3) {
      if (Math.abs(x) < 2 && z < -4) continue;
      const person = new THREE.Mesh(new THREE.CapsuleGeometry ? new THREE.CapsuleGeometry(0.3, 1, 4, 8) : new THREE.CylinderGeometry(0.3, 0.3, 1.6, 8), crowdMat);
      person.position.set(x + (Math.random() - 0.5), 0.9, z + (Math.random() - 0.5));
      person.castShadow = true;
      scene.add(person);
    }
  }

  // Hareket kontrolü
  let yaw = 0, pitch = 0;
  let moveF = false, moveB = false, moveL = false, moveR = false;
  let locked = false;

  renderer.domElement.addEventListener("click", () => {
    renderer.domElement.requestPointerLock();
  });

  document.addEventListener("pointerlockchange", () => {
    locked = document.pointerLockElement === renderer.domElement;
  });

  document.addEventListener("mousemove", (e) => {
    if (!locked) return;
    yaw -= e.movementX * 0.002;
    pitch -= e.movementY * 0.002;
    pitch = Math.max(-Math.PI / 2 + 0.05, Math.min(Math.PI / 2 - 0.05, pitch));
  });

  document.addEventListener("keydown", (e) => {
    if (e.code === "KeyW") moveF = true;
    if (e.code === "KeyS") moveB = true;
    if (e.code === "KeyA") moveL = true;
    if (e.code === "KeyD") moveR = true;
  });
  document.addEventListener("keyup", (e) => {
    if (e.code === "KeyW") moveF = false;
    if (e.code === "KeyS") moveB = false;
    if (e.code === "KeyA") moveL = false;
    if (e.code === "KeyD") moveR = false;
  });

  window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });


  // --- Dokunmatik kontroller (mobil) ---
  const isTouch = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;
  const joystick = document.getElementById("joystick");
  const joystickKnob = document.getElementById("joystickKnob");
  const lookZone = document.getElementById("lookZone");

  let joyActive = false, joyStartX = 0, joyStartY = 0, joyDX = 0, joyDY = 0;
  let lookActive = false, lookLastX = 0, lookLastY = 0;

  if (isTouch) {
    joystick.style.display = "block";
    lookZone.style.display = "block";
    document.getElementById("hint").style.display = "block";

    joystick.addEventListener("touchstart", (e) => {
      joyActive = true;
      const t = e.touches[0];
      joyStartX = t.clientX;
      joyStartY = t.clientY;
    }, { passive: true });

    joystick.addEventListener("touchmove", (e) => {
      if (!joyActive) return;
      const t = e.touches[0];
      joyDX = t.clientX - joyStartX;
      joyDY = t.clientY - joyStartY;
      const maxDist = 40;
      const dist = Math.min(maxDist, Math.hypot(joyDX, joyDY));
      const angle = Math.atan2(joyDY, joyDX);
      const kx = Math.cos(angle) * dist;
      const ky = Math.sin(angle) * dist;
      joystickKnob.style.left = (35 + kx) + "px";
      joystickKnob.style.top = (35 + ky) + "px";
      joyDX = kx / maxDist;
      joyDY = ky / maxDist;
    }, { passive: true });

    function resetJoystick() {
      joyActive = false;
      joyDX = 0;
      joyDY = 0;
      joystickKnob.style.left = "35px";
      joystickKnob.style.top = "35px";
    }
    joystick.addEventListener("touchend", resetJoystick, { passive: true });
    joystick.addEventListener("touchcancel", resetJoystick, { passive: true });

    lookZone.addEventListener("touchstart", (e) => {
      lookActive = true;
      const t = e.touches[0];
      lookLastX = t.clientX;
      lookLastY = t.clientY;
    }, { passive: true });

    lookZone.addEventListener("touchmove", (e) => {
      if (!lookActive) return;
      const t = e.touches[0];
      const dx = t.clientX - lookLastX;
      const dy = t.clientY - lookLastY;
      lookLastX = t.clientX;
      lookLastY = t.clientY;
      yaw -= dx * 0.004;
      pitch -= dy * 0.004;
      pitch = Math.max(-Math.PI / 2 + 0.05, Math.min(Math.PI / 2 - 0.05, pitch));
    }, { passive: true });

    lookZone.addEventListener("touchend", () => { lookActive = false; }, { passive: true });
    lookZone.addEventListener("touchcancel", () => { lookActive = false; }, { passive: true });
  }

  function animate() {
    requestAnimationFrame(animate);

    camera.rotation.order = "YXZ";
    camera.rotation.y = yaw;
    camera.rotation.x = pitch;

    const speed = 0.15;
    const forward = new THREE.Vector3(Math.sin(yaw), 0, Math.cos(yaw));
    const right = new THREE.Vector3(Math.sin(yaw + Math.PI / 2), 0, Math.cos(yaw + Math.PI / 2));

    if (moveF) camera.position.addScaledVector(forward, -speed);
    if (moveB) camera.position.addScaledVector(forward, speed);
    if (moveL) camera.position.addScaledVector(right, -speed);
    if (moveR) camera.position.addScaledVector(right, speed);

    if (isTouch && (joyDX !== 0 || joyDY !== 0)) {
      camera.position.addScaledVector(forward, joyDY * speed);
      camera.position.addScaledVector(right, joyDX * speed);
    }

    camera.position.x = Math.max(-45, Math.min(45, camera.position.x));
    camera.position.z = Math.max(-24, Math.min(45, camera.position.z));

    // ışıkları hafif titret (konser hissi)
    scene.traverse((obj) => {
      if (obj.isPointLight) {
        obj.intensity = 1.6 + Math.sin(Date.now() * 0.003 + obj.position.x) * 0.6;
      }
    });

    renderer.render(scene, camera);
  }
  animate();
}
</script>
</body>
</html>

